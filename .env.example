# Copy to .env and fill in real values. Never commit .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=zircondsphotos

# Optional: protect POST /api/scrape with Bearer token auth.
# Leave empty to allow unauthenticated scrape triggers (local dev).
# On Render, set this as a secret env var (Render dashboard → Environment).
SCRAPE_API_KEY=

# CORS origin for the Render server. Override for local dev.
# Production value is set in render.yaml.
CORS_ORIGIN=*
